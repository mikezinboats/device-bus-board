# 1. Ignore absolutely everything by default
*

# 2. Allow the .gitignore file itself to be tracked
!.gitignore

# 3. Allow core KiCad design files
!*.kicad_pro
!*.kicad_pcb
!*.kicad_sch

# 4. Allow legacy/older KiCad design files (Optional)
!*.pro
!*.sch

# 4. Allow .zip files for Gerber Releases
!*.zip

fp-info-cache
*-backups
README.txt
